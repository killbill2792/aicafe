# Copy to .env.local and fill in. See PROGRESS.md → "Needs connecting" for exact steps.

# M0 — required to run the app at all
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# M1 — required for auth, RLS-bypassing server code, and `npm run db:reset`
SUPABASE_SERVICE_ROLE_KEY=
# Direct/pooled Postgres connection string (Settings → Database → Connection string → URI).
# Only used by scripts/db-reset.mjs to apply supabase/migrations/*.sql; never imported by the app.
SUPABASE_DB_URL=

# M4 — AI provider for statement categorizing, receipt reading, voice entry (lib/ai/)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=

# M5 — Square OAuth (sandbox first)
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
SQUARE_REDIRECT_URI=http://localhost:3000/api/pos/square/callback

# M5 — encrypts pos_connections.*_token_enc at rest (generate with: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# M8 — error tracking (optional for the pilot). Both are the same DSN value from your Sentry
# project — SENTRY_DSN is read server/edge-side, NEXT_PUBLIC_SENTRY_DSN client-side (it must be
# public since it ships in the browser bundle; it only accepts events, it can't read your data).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
