{
  "id": "14e-payables",
  "mode": "generic",
  "engine": "node-server",
  "entrypoint": "evals/acceptance/live/task14e-payables.mjs",
  "proof": "14e-payables-proof.json",
  "scope": "14e-payables-scope.json",
  "expectedTools": [
    "get_cashflow_evidence",
    "get_bills",
    "propose_invoice_reconciliation",
    "propose_financial_bill"
  ],
  "assertions": [
    {
      "name": "current-invoice",
      "kind": "source",
      "table": "public.supplier_invoices",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "id": {
          "scope": "invoiceId"
        },
        "supplier_id": {
          "scope": "supplierId"
        },
        "revision": {
          "eq": "2"
        },
        "total_cents": {
          "eq": "18000"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "both-invoice-revisions",
      "kind": "source",
      "table": "public.supplier_invoices",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "supplier_id": {
          "scope": "supplierId"
        }
      },
      "minCount": 2,
      "maxCount": 2
    },
    {
      "name": "documented-bill",
      "kind": "source",
      "table": "public.uploads",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "id": {
          "scope": "billId"
        },
        "kind": {
          "eq": "bill_claim"
        },
        "financial_bill_amount_cents": {
          "eq": "7500"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "committed-invoice",
      "kind": "source",
      "table": "public.supervisor_proposals",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "id": {
          "scope": "invoiceProposalId"
        },
        "owner_user_id": {
          "scope": "ownerUserId"
        },
        "status": {
          "eq": "committed"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "committed-bill",
      "kind": "source",
      "table": "public.supervisor_proposals",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "id": {
          "scope": "billProposalId"
        },
        "owner_user_id": {
          "scope": "ownerUserId"
        },
        "status": {
          "eq": "committed"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "committed-revision",
      "kind": "source",
      "table": "public.supervisor_proposals",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "id": {
          "scope": "correctionProposalId"
        },
        "owner_user_id": {
          "scope": "ownerUserId"
        },
        "status": {
          "eq": "committed"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "owner-finance-reply",
      "kind": "owner",
      "table": "public.ai_messages",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "thread_id": {
          "scope": "threadId"
        },
        "id": {
          "scope": "reportReplyId"
        },
        "role": {
          "eq": "supervisor"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "foreign-invoice",
      "kind": "isolation",
      "table": "public.supplier_invoices",
      "where": {
        "business_id": {
          "scope": "otherCafeId"
        },
        "id": {
          "scope": "invoiceId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    },
    {
      "name": "foreign-bill",
      "kind": "isolation",
      "table": "public.uploads",
      "where": {
        "business_id": {
          "scope": "otherCafeId"
        },
        "id": {
          "scope": "billId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    }
  ]
}
