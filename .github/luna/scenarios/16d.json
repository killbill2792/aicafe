    {"name":"invoice-verified-approval","kind":"source","table":"public.supervisor_proposals","where":{"business_id":{"scope":"businessId"},"id":{"scope":"invoiceProposalId"},"status":{"eq":"committed"}},"minCount":1,"maxCount":1},
