    {"name":"foreign-stock-denied","kind":"isolation","table":"public.pantry_stock_purchases","where":{"business_id":{"scope":"otherCafeId"},"ingredient_id":{"scope":"ingredientId"}},"minCount":0,"maxCount":0},
    {"name":"no-stock-from-documentary-invoice","kind":"source","table":"public.pantry_stock_purchases","where":{"business_id":{"scope":"businessId"},"ingredient_id":{"scope":"ingredientId"}},"minCount":0,"maxCount":0}
  ]
