{
  "id": "8a-price-observation",
  "mode": "generic",
  "engine": "node-server",
  "entrypoint": "evals/acceptance/live/task8a-price-observation.mjs",
  "proof": "8a-price-observation-proof.json",
  "scope": "8a-price-observation-scope.json",
  "expectedTools": [
    "get_price_monitor_status",
    "describe_data"
  ],
  "assertions": [
    {
      "name": "canonical-price-history",
      "kind": "source",
      "table": "public.menu_price_history",
      "where": {
        "id": {
          "scope": "historyId"
        },
        "business_id": {
          "scope": "businessId"
        },
        "menu_item_id": {
          "scope": "itemId"
        },
        "source_provider": {
          "eq": "toast"
        },
        "source_type": {
          "eq": "connected_pos"
        },
        "old_price_cents": {
          "eq": "500"
        },
        "new_price_cents": {
          "eq": "550"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "elapsed-measured-windows",
      "kind": "source",
      "table": "public.supervisor_monitor_windows",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "source_id": {
          "scope": "sourceId"
        },
        "monitor_kind": {
          "eq": "toast_price_observation"
        },
        "coverage_status": {
          "eq": "actual"
        },
        "units": {
          "eq": "8"
        },
        "revenue_cents": {
          "eq": "4400"
        }
      },
      "minCount": 7,
      "maxCount": 7
    },
    {
      "name": "owner-model-message",
      "kind": "owner",
      "table": "public.ai_messages",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "owner_user_id": {
          "scope": "ownerUserId"
        },
        "thread_id": {
          "scope": "threadId"
        },
        "id": {
          "scope": "replyId"
        },
        "role": {
          "eq": "supervisor"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "owner-proactive-messages",
      "kind": "owner",
      "table": "public.ai_messages",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "owner_user_id": {
          "scope": "ownerUserId"
        },
        "thread_id": {
          "scope": "threadId"
        },
        "role": {
          "eq": "supervisor"
        }
      },
      "minCount": 10,
      "maxCount": 10
    },
    {
      "name": "foreign-cafe-window-denied",
      "kind": "isolation",
      "table": "public.supervisor_monitor_windows",
      "where": {
        "business_id": {
          "scope": "foreignBusinessId"
        },
        "source_id": {
          "scope": "sourceId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    },
    {
      "name": "no-unauthorized-proposal",
      "kind": "source",
      "table": "public.supervisor_proposals",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "thread_id": {
          "scope": "threadId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    },
    {
      "name": "original-source-price-unchanged",
      "kind": "source",
      "table": "public.menu_items",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "id": {
          "scope": "itemId"
        },
        "price_cents": {
          "eq": "550"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "all-nine-owner-notice-receipts",
      "kind": "owner",
      "table": "public.supervisor_experiment_notice_receipts",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "owner_user_id": {
          "scope": "ownerUserId"
        },
        "source_id": {
          "scope": "sourceId"
        },
        "state": {
          "eq": "posted"
        }
      },
      "minCount": 9,
      "maxCount": 9
    },
    {
      "name": "seven-daily-notice-receipts",
      "kind": "owner",
      "table": "public.supervisor_experiment_notice_receipts",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "owner_user_id": {
          "scope": "ownerUserId"
        },
        "source_id": {
          "scope": "sourceId"
        },
        "kind": {
          "eq": "toast_price_daily"
        },
        "state": {
          "eq": "posted"
        }
      },
      "minCount": 7,
      "maxCount": 7
    }
  ]
}
