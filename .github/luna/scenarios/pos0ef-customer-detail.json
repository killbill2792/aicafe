          "eq": "owner"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "no-unapproved-effect",
      "kind": "source",
      "table": "public.supervisor_effect_attempts",
      "where": {
        "business_id": {
          "scope": "businessId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    },
    {
      "name": "no-foreign-restaurant-receipts",
      "kind": "isolation",
      "table": "public.toast_raw_records",
      "where": {
        "business_id": {
          "scope": "foreignBusinessId"
        },
        "restaurant_guid": {
