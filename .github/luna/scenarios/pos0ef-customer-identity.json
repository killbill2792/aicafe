      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "no-unauthorized-effect",
      "kind": "source",
      "table": "public.supervisor_effect_attempts",
      "where": {
        "business_id": {
          "scope": "businessId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    },
    {
      "name": "no-foreign-episode",
      "kind": "isolation",
      "table": "public.supervisor_investigations",
      "where": {
        "business_id": {
          "scope": "foreignBusinessId"
        },
        "episode_id": {
          "scope": "episodeId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    }
  ]
