{
  "id": "sql-research-data",
  "mode": "generic",
  "engine": "node-server",
  "entrypoint": "evals/acceptance/live/sql-research.mjs",
  "proof": "sql-research-data-proof.json",
  "scope": "sql-research-data-scope.json",
  "expectedTools": [
    "describe_database",
    "run_sql"
  ],
  "assertions": [
    {
      "name": "source-orders",
      "kind": "source",
      "table": "public.orders",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "business_date": {
          "scope": "endDate"
        }
      },
      "minCount": 1,
      "maxCount": 10000
    },
    {
      "name": "owner-answer",
      "kind": "owner",
      "table": "public.ai_messages",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "thread_id": {
          "scope": "threadId"
        },
        "id": {
          "scope": "replyId"
        },
        "role": {
          "eq": "supervisor"
        }
      },
      "minCount": 1,
      "maxCount": 1
    },
    {
      "name": "foreign-thread",
      "kind": "isolation",
      "table": "public.ai_threads",
      "where": {
        "business_id": {
          "scope": "otherCafeId"
        },
        "id": {
          "scope": "threadId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    },
    {
      "name": "no-effect",
      "kind": "source",
      "table": "public.supervisor_proposals",
      "where": {
        "business_id": {
          "scope": "businessId"
        },
        "thread_id": {
          "scope": "threadId"
        }
      },
      "minCount": 0,
      "maxCount": 0
    }
  ]
}
